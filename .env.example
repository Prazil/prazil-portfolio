# Prazilkar Portfolio Environment Configuration

# Google Apps Script Contact Backend (Recommended: Saves to Google Sheet + Sends Gmail)
# Paste your deployed Google Apps Script Web App Exec URL here:
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# (Optional) EmailJS Alternative Backend
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
